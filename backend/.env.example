# =================================================================
# ORCA Environment Variables & API Keys Collection
# =================================================================

# -----------------------------------------------------------------
# 1. CORE / REQUIRED TO RUN ORCA
# -----------------------------------------------------------------
# Get a free key at: https://ollama.com
OLLAMA_API_KEY=

# Local proxy key (optional if not running local Omniroute)
OMNIROUTE_API_KEY=

# JWT Secret for user session tokens (change for production)
JWT_SECRET=orca-dev-secret-change-me-before-any-real-deployment


# -----------------------------------------------------------------
# 2. MARINE & OCEAN DATA (FROM public-apis)
# -----------------------------------------------------------------
# Storm Glass - Marine weather, swells, currents, water temp
# Sign up: https://stormglass.io/
STORMGLASS_API_KEY=

# OpenWeatherMap - Severe weather alerts & barometric pressure
# Sign up: https://home.openweathermap.org/users/sign_up
OPENWEATHER_API_KEY=

# Weatherstack - Real-time global weather
# Sign up: https://weatherstack.com/signup/free
WEATHERSTACK_API_KEY=

# Tomorrow.io - Hyperlocal nowcasting (wind gusts, lightning)
# Sign up: https://app.tomorrow.io/signup
TOMORROW_API_KEY=


# -----------------------------------------------------------------
# 3. GEOCODING & MAPS (FROM public-apis)
# -----------------------------------------------------------------
# Mapbox - Custom nautical maps, satellite, bathymetry
# Sign up: https://account.mapbox.com/auth/signup/
MAPBOX_API_KEY=

# OpenCage - Fast forward/reverse geocoding
# Sign up: https://opencagedata.com/users/sign_up
OPENCAGE_API_KEY=

# Positionstack - Batch geocoding
# Sign up: https://positionstack.com/signup/free
POSITIONSTACK_API_KEY=

# Openrouteservice - Direction and coastal routing
# Sign up: https://openrouteservice.org/dev/#/signup
OPENROUTESERVICE_API_KEY=


# -----------------------------------------------------------------
# 4. CONSERVATION & RESEARCH (FROM public-apis)
# -----------------------------------------------------------------
# IUCN Red List (v4) - Marine endangered wildlife / MPA protection
# Sign up: https://api.iucnredlist.org/users/sign_up
IUCN_API_KEY=


# -----------------------------------------------------------------
# 5. INDIAN GOVERNMENT APIS (OPTIONAL / FORMAL ACCESS)
# -----------------------------------------------------------------
# India Meteorological Department (api.imd.gov.in)
IMD_API_KEY=

# ISRO MOSDAC (mosdac.gov.in)
MOSDAC_TOKEN=
